{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "haMinVersion",
      "type": "promptString",
      "description": "Minimum HA version for hacs.json (oldest release with all APIs used, NOT the pyproject test pin)"
    }
  ],
  "tasks": [
    {
      "label": "Bump HACS min HA",
      "type": "shell",
      "command": "uv run python scripts/bump_ha_min.py ${input:haMinVersion}",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Show HA versions",
      "type": "shell",
      "command": "uv run python scripts/bump_ha_min.py",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Prek",
      "type": "shell",
      "command": "uv run prek run --all-files",
      "dependsOn": ["Install Dev Requirements"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Install Dev Requirements",
      "type": "shell",
      "command": "uv sync --all-groups",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Pytest",
      "type": "shell",
      "command": "uv run pytest --cov=custom_components/asusrouter --cov-report=xml:pytest/report.xml --cov-report=term-missing -vv",
      "dependsOn": ["Install Dev Requirements"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "problemMatcher": []
    }
  ]
}
